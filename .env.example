# Copy to .env.local for development, and set the same values in the
# Vercel project's Environment Variables for production.

# CRM lead delivery — every form submission POSTs a JSON payload here.
# Leave unset and leads are only logged server-side (no CRM delivery).
CRM_WEBHOOK_URL=

# Optional: sent as `Authorization: Bearer <value>` if your CRM's webhook
# requires it (Zoho, HubSpot and most others also let you put a secret
# token directly in the URL instead, which needs no header at all).
CRM_WEBHOOK_TOKEN=
